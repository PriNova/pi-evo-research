{
  "name": "pi-evo-research",
  "version": "1.6.0",
  "type": "module",
  "description": "Population-guided evolutionary research for pi — evolve hypotheses, run measured experiments, keep what works.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "experiment",
    "optimization",
    "benchmark",
    "coding-agent",
    "evolutionary-search",
    "population-search",
    "agent-optimization",
    "pi-evo-research",
    "evo-research"
  ],
  "license": "MIT",
  "author": "PriNova",
  "homepage": "https://github.com/PriNova/pi-evo-research#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PriNova/pi-evo-research.git"
  },
  "bugs": {
    "url": "https://github.com/PriNova/pi-evo-research/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "extensions",
    "skills",
